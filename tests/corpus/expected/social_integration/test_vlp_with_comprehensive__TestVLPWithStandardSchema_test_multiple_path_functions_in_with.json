 "cypher": "MATCH path = (u1:User)-[:FOLLOWS*1..2]->(u2:User)\n        WHERE u1.user_id = 1\n        WITH u1, u2, \n             length(path) as hops,\n             nodes(path) as path_nodes,\n             relationships(path) as path_rels\n        WHERE hops = 2\n        RETURN u1.name, u2.name, hops, \n               size(path_nodes) as node_count,\n               size(path_rels) as rel_count",
